import { daysBetween, yearsBetween } from '../utils/dateUtils';
import { getMEPHistorico } from './mepAPI';
import type { CashFlow, MWRResult, Portfolio, MEPComparison, ChartDataPoint, MWRinUSD } from '../types';
import { calculateInflacionComparison } from './inflacionCalculator';
import { calculateMWRinUSD } from './mwrUSDCalculator';

/**
 * Calculate Net Present Value (NPV) for a given rate
 */
function calculateNPV(
  cashflows: CashFlow[],
  finalValue: number,
  rate: number,
  firstDate: Date,
  lastDate: Date
): number {
  let npv = 0;

  // Add all cashflows (negative for deposits, positive for withdrawals)
  for (const cf of cashflows) {
    const days = daysBetween(firstDate, cf.date);
    const years = days / 365;
    const discountFactor = Math.pow(1 + rate, years);

    // Deposits are negative cashflows (money out of your pocket)
    // Withdrawals are positive cashflows (money into your pocket)
    const amount = cf.type === 'deposit' ? -cf.amount : cf.amount;
    npv += amount / discountFactor;
  }

  // Add final portfolio value as a positive cashflow
  const totalDays = daysBetween(firstDate, lastDate);
  const totalYears = totalDays / 365;
  const finalDiscountFactor = Math.pow(1 + rate, totalYears);
  npv += finalValue / finalDiscountFactor;

  return npv;
}

/**
 * Calculate derivative of NPV for Newton-Raphson method
 */
function calculateNPVDerivative(
  cashflows: CashFlow[],
  finalValue: number,
  rate: number,
  firstDate: Date,
  lastDate: Date
): number {
  let derivative = 0;

  // Derivative of each cashflow term
  for (const cf of cashflows) {
    const days = daysBetween(firstDate, cf.date);
    const years = days / 365;
    const discountFactor = Math.pow(1 + rate, years);

    const amount = cf.type === 'deposit' ? -cf.amount : cf.amount;
    derivative -= (amount * years) / discountFactor / (1 + rate);
  }

  // Derivative of final value term
  const totalDays = daysBetween(firstDate, lastDate);
  const totalYears = totalDays / 365;
  const finalDiscountFactor = Math.pow(1 + rate, totalYears);
  derivative -= (finalValue * totalYears) / finalDiscountFactor / (1 + rate);

  return derivative;
}

/**
 * Calculate MWR using Newton-Raphson method
 */
function calculateMWRNewtonRaphson(
  cashflows: CashFlow[],
  finalValue: number,
  firstDate: Date,
  lastDate: Date
): number {
  const MAX_ITERATIONS = 100;
  const TOLERANCE = 1e-10;

  // Initial guess: 10% annual return
  let rate = 0.1;

  for (let i = 0; i < MAX_ITERATIONS; i++) {
    const npv = calculateNPV(cashflows, finalValue, rate, firstDate, lastDate);
    const derivative = calculateNPVDerivative(cashflows, finalValue, rate, firstDate, lastDate);

    // Avoid division by zero
    if (Math.abs(derivative) < 1e-15) {
      break;
    }

    const delta = npv / derivative;
    rate = rate - delta;

    // Check for convergence
    if (Math.abs(delta) < TOLERANCE) {
      break;
    }

    // Prevent negative rates that are too extreme
    if (rate < -0.99) {
      rate = -0.99;
    }
  }

  return rate;
}

/**
 * Calculate MWR using Bisection method (more robust fallback)
 */
function calculateMWRBisection(
  cashflows: CashFlow[],
  finalValue: number,
  firstDate: Date,
  lastDate: Date
): number {
  const MAX_ITERATIONS = 100;
  const TOLERANCE = 1e-10;

  // Start with a wide range
  let lowRate = -0.99;
  let highRate = 10.0; // 1000% annual return as upper bound

  for (let i = 0; i < MAX_ITERATIONS; i++) {
    const midRate = (lowRate + highRate) / 2;
    const npv = calculateNPV(cashflows, finalValue, midRate, firstDate, lastDate);

    if (Math.abs(npv) < TOLERANCE) {
      return midRate;
    }

    const npvLow = calculateNPV(cashflows, finalValue, lowRate, firstDate, lastDate);

    // Adjust bounds
    if ((npvLow > 0 && npv > 0) || (npvLow < 0 && npv < 0)) {
      lowRate = midRate;
    } else {
      highRate = midRate;
    }

    // Check for convergence
    if (Math.abs(highRate - lowRate) < TOLERANCE) {
      return midRate;
    }
  }

  return (lowRate + highRate) / 2;
}

/**
 * Validate cashflows and portfolio data
 */
function validateInputs(cashflows: CashFlow[], portfolio: Portfolio): void {
  if (cashflows.length === 0) {
    throw new Error('No hay flujos de caja para calcular');
  }

  const deposits = cashflows.filter(cf => cf.type === 'deposit');
  if (deposits.length === 0) {
    throw new Error('Debe haber al menos un depósito');
  }

  if (portfolio.totalValue <= 0) {
    throw new Error('El valor del portfolio debe ser mayor a cero');
  }

  // Check for valid dates
  for (const cf of cashflows) {
    if (!(cf.date instanceof Date) || isNaN(cf.date.getTime())) {
      throw new Error(`Fecha inválida en flujo: ${cf.description}`);
    }
  }
}

/**
 * Calculate alternative scenario: buying MEP dollars with each deposit
 * and selling them with each withdrawal
 */
function calculateMEPComparison(
  cashflows: CashFlow[],
  currentMEPRate: number,
  duracionAnios: number,
  totalInvertido: number
): MEPComparison {
  let dolaresAcumulados = 0;
  let totalDolaresComprados = 0;
  let totalDolaresVendidos = 0;

  console.log('💵 Calculando escenario alternativo: comprar dólar MEP...');
  console.log(`💵 Inversión total (suma de depósitos): $${totalInvertido.toLocaleString()}`);

  // Process each cashflow
  for (const cf of cashflows) {
    const mepRate = cf.mepRate || currentMEPRate;

    if (cf.type === 'deposit') {
      // Comprar dólares con este depósito
      const dolaresComprados = cf.amount / mepRate;
      dolaresAcumulados += dolaresComprados;
      totalDolaresComprados += dolaresComprados;

      console.log(`  📥 ${cf.date.toLocaleDateString('es-AR')}: Depósito $${cf.amount.toLocaleString()} → Compra USD ${dolaresComprados.toFixed(2)} @ $${mepRate.toFixed(2)}`);
    } else {
      // Vender dólares con este retiro (para sacar la plata que necesitas)
      const dolaresVendidos = cf.amount / mepRate;
      dolaresAcumulados -= dolaresVendidos;
      totalDolaresVendidos += dolaresVendidos;

      console.log(`  📤 ${cf.date.toLocaleDateString('es-AR')}: Retiro $${cf.amount.toLocaleString()} → Venta USD ${dolaresVendidos.toFixed(2)} @ $${mepRate.toFixed(2)}`);
    }
  }

  // Calculate final value in ARS using current MEP rate
  const valorFinalARS = dolaresAcumulados * currentMEPRate;
  const gananciaARS = valorFinalARS - totalInvertido;
  const rendimientoTotal = totalInvertido > 0 ? gananciaARS / totalInvertido : 0;
  const rendimientoAnualizado = duracionAnios > 0
    ? Math.pow(1 + rendimientoTotal, 1 / duracionAnios) - 1
    : 0;

  console.log(`💵 Resultado MEP:`);
  console.log(`  Total invertido (depósitos): $${totalInvertido.toLocaleString()}`);
  console.log(`  USD comprados: ${totalDolaresComprados.toFixed(2)}`);
  console.log(`  USD vendidos (por retiros): ${totalDolaresVendidos.toFixed(2)}`);
  console.log(`  USD finales que tenés: ${dolaresAcumulados.toFixed(2)}`);
  console.log(`  MEP actual: $${currentMEPRate.toFixed(2)}`);
  console.log(`  Valor final si vendés todo hoy: $${valorFinalARS.toLocaleString()}`);
  console.log(`  Ganancia vs inversión original: $${gananciaARS.toLocaleString()}`);
  console.log(`  Rendimiento: ${(rendimientoTotal * 100).toFixed(2)}% total, ${(rendimientoAnualizado * 100).toFixed(2)}% anual`);

  return {
    totalDolaresComprados,
    totalDolaresVendidos,
    dolaresFinales: dolaresAcumulados,
    valorFinalARS,
    inversionTotalARS: totalInvertido, // Solo depósitos, NO restamos retiros
    gananciaARS,
    rendimientoTotal,
    rendimientoAnualizado,
    diferenciaMWR: 0, // Se calculará después
    ventajaPortfolio: 0, // Se calculará después
  };
}

/**
 * Calculate MWR and generate complete results
 */
export function calculateMWR(
  cashflows: CashFlow[],
  portfolio: Portfolio
): MWRResult {
  // Validate inputs
  validateInputs(cashflows, portfolio);

  // Sort cashflows by date
  const sortedCashflows = [...cashflows].sort((a, b) =>
    a.date.getTime() - b.date.getTime()
  );

  // Get first and last dates
  const firstDate = sortedCashflows[0].date;
  const lastDate = portfolio.fecha;

  // Calculate total invested (sum of deposits minus withdrawals)
  const totalInvertido = sortedCashflows.reduce((sum, cf) => {
    return sum + (cf.type === 'deposit' ? cf.amount : -cf.amount);
  }, 0);

  console.log('🔢 Datos para cálculo de MWR:');
  console.log('  Total invertido (depósitos):', totalInvertido.toLocaleString('es-AR'));
  console.log('  Valor actual portfolio:', portfolio.totalValue.toLocaleString('es-AR'));
  console.log('  Ganancia:', (portfolio.totalValue - totalInvertido).toLocaleString('es-AR'));
  console.log('  Retorno simple:', ((portfolio.totalValue - totalInvertido) / totalInvertido * 100).toFixed(2) + '%');
  console.log('  Primer flujo:', sortedCashflows[0].date.toLocaleDateString('es-AR'));
  console.log('  Último flujo:', sortedCashflows[sortedCashflows.length - 1].date.toLocaleDateString('es-AR'));
  console.log('  Cantidad de flujos:', sortedCashflows.length);
  console.log('  Depósitos:', sortedCashflows.filter(cf => cf.type === 'deposit').length);
  console.log('  Retiros:', sortedCashflows.filter(cf => cf.type === 'withdrawal').length);

  // Calculate MWR using Newton-Raphson
  let mwrAnualizado: number;
  try {
    mwrAnualizado = calculateMWRNewtonRaphson(
      sortedCashflows,
      portfolio.totalValue,
      firstDate,
      lastDate
    );

    // If result is unreasonable, try bisection method
    if (isNaN(mwrAnualizado) || Math.abs(mwrAnualizado) > 100) {
      console.warn('Newton-Raphson produced unreasonable result, using bisection');
      mwrAnualizado = calculateMWRBisection(
        sortedCashflows,
        portfolio.totalValue,
        firstDate,
        lastDate
      );
    }
  } catch (error) {
    console.warn('Newton-Raphson failed, using bisection:', error);
    mwrAnualizado = calculateMWRBisection(
      sortedCashflows,
      portfolio.totalValue,
      firstDate,
      lastDate
    );
  }

  // Calculate duration in years
  const duracionAnios = yearsBetween(firstDate, lastDate);

  // Calculate simple return (this is the REAL total return for the period)
  const ganancia = portfolio.totalValue - totalInvertido;
  const retornoSimple = totalInvertido > 0 ? ganancia / totalInvertido : 0;

  // The total return for the period is just the simple return
  // NOT the compounded MWR (which would be misleading)
  const mwrTotal = retornoSimple;

  // Calculate MEP comparison
  const mepComparison = calculateMEPComparison(
    sortedCashflows,
    portfolio.mepRate,
    duracionAnios,
    totalInvertido
  );

  // Update MEP comparison with differences
  mepComparison.diferenciaMWR = mwrAnualizado - mepComparison.rendimientoAnualizado;
  mepComparison.ventajaPortfolio = ganancia - mepComparison.gananciaARS;

  console.log('📊 Comparación Portfolio vs MEP:');
  console.log(`  Portfolio: ${(mwrAnualizado * 100).toFixed(2)}% anual, ganancia $${ganancia.toLocaleString()}`);
  console.log(`  Solo MEP: ${(mepComparison.rendimientoAnualizado * 100).toFixed(2)}% anual, ganancia $${mepComparison.gananciaARS.toLocaleString()}`);
  console.log(`  Diferencia: ${(mepComparison.diferenciaMWR * 100).toFixed(2)}% anual, $${mepComparison.ventajaPortfolio.toLocaleString()} adicionales`);

  return {
    mwrAnualizado,
    mwrTotal,
    duracionAnios,
    totalInvertido,
    valorActual: portfolio.totalValue,
    ganancia,
    retornoSimple,
    cashflows: sortedCashflows,
    portfolio,
    mepComparison,
  };
}

/**
 * Generate chart data points for portfolio evolution (in ARS and USD)
 */
export async function generatePortfolioEvolution(
  cashflows: CashFlow[],
  finalValue: number,
  mwrAnualizado: number,
  currentMEPRate: number
): Promise<ChartDataPoint[]> {
  if (cashflows.length === 0) return [];

  const sortedCashflows = [...cashflows].sort((a, b) =>
    a.date.getTime() - b.date.getTime()
  );

  const firstDate = sortedCashflows[0].date;
  const data: ChartDataPoint[] = [];

  let portfolioValue = 0;
  let lastDate = firstDate;

  // Process each cashflow
  for (const cf of sortedCashflows) {
    // Calculate growth since last event
    const yearsSinceLastEvent = yearsBetween(lastDate, cf.date);
    const growthFactor = Math.pow(1 + mwrAnualizado, yearsSinceLastEvent);

    // Apply growth to current portfolio value
    portfolioValue = portfolioValue * growthFactor;

    // Get MEP rate for this date
    const mepRate = cf.mepRate || currentMEPRate;

    // Add point BEFORE applying the cashflow (to see the growth)
    if (cf.date.getTime() !== firstDate.getTime()) {
      data.push({
        date: cf.date.toISOString().split('T')[0],
        value: portfolioValue,
        valueUSD: portfolioValue / mepRate,
        mepRate: mepRate,
      });
    }

    // Apply the cashflow
    if (cf.type === 'deposit') {
      portfolioValue += cf.amount;
    } else {
      portfolioValue -= cf.amount;
    }

    // Add point AFTER applying the cashflow (to see the jump)
    data.push({
      date: cf.date.toISOString().split('T')[0],
      value: portfolioValue,
      valueUSD: portfolioValue / mepRate,
      mepRate: mepRate,
      deposits: cf.type === 'deposit' ? cf.amount : undefined,
    });

    lastDate = cf.date;
  }

  // Add final point (growth from last cashflow to today)
  const today = new Date();
  const finalYears = yearsBetween(lastDate, today);
  const finalGrowth = Math.pow(1 + mwrAnualizado, finalYears);

  data.push({
    date: today.toISOString().split('T')[0],
    value: finalValue,
    valueUSD: finalValue / currentMEPRate,
    mepRate: currentMEPRate,
  });

  console.log('📈 Evolución del portfolio generada:', data.length, 'puntos');
  console.log('Primer valor ARS:', data[0]?.value.toLocaleString());
  console.log('Primer valor USD:', data[0]?.valueUSD.toFixed(2));
  console.log('Último valor ARS:', data[data.length - 1]?.value.toLocaleString());
  console.log('Último valor USD:', data[data.length - 1]?.valueUSD.toFixed(2));

  return data;
}
